# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/project_id/settings/api-keys/new
# Use the new publishable key (sb_publishable_...) instead of legacy anon key
EXPO_PUBLIC_SUPABASE_URL=https://project_id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_sb_publishable_key_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_sb_anon_key_here...
EXPO_PUBLIC_GOOGLE_AUTH_WEB_CLIENT_ID=authWebClientId.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_AUTH_IOS_CLIENT_ID=authIosClientId.apps.googleusercontent.com
SUPABASE_PASSWORD=your_sb_password_here

# App Configuration
EXPO_PUBLIC_GITHUB_REPO_URL=https://github.com/CalPinSW/Temur
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://github.com/CalPinSW/Temur/blob/main/PRIVACY_POLICY.md
EXPO_PUBLIC_SUPPORT_EMAIL=calpinsw@gmail.com

