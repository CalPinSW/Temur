# Supabase Configuration
# Same project as apps/mobile — get these from:
# https://supabase.com/dashboard/project/project_id/settings/api-keys/new
NEXT_PUBLIC_SUPABASE_URL=https://project_id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_sb_publishable_key_here

# Used to build absolute redirect URLs for email confirmation / magic links.
# Set to your Vercel deployment URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Profile page links (optional — omitted if unset)
NEXT_PUBLIC_PRIVACY_POLICY_URL=https://github.com/CalPinSW/Temur/blob/main/PRIVACY_POLICY.md
NEXT_PUBLIC_SUPPORT_EMAIL=calpinsw@gmail.com

# About page "View on GitHub" link (optional — omitted if unset)
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/CalPinSW/Temur

# Social sign-in (ID token flow — see README's "Social Sign-In" section).
# NEXT_PUBLIC_GOOGLE_CLIENT_ID is the same Google Cloud "Web application"
# OAuth client already used for the Supabase Google provider (matches
# apps/mobile's EXPO_PUBLIC_GOOGLE_AUTH_WEB_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=authWebClientId.apps.googleusercontent.com
# The Apple Services ID (Sign in with Apple) — the same Client ID already
# configured for Supabase's Apple provider.
NEXT_PUBLIC_APPLE_CLIENT_ID=com.calpin.temur.web

# Sentry error monitoring (optional — Sentry.init() no-ops if unset).
# https://softwire-zd.sentry.io — project "temur-web".
NEXT_PUBLIC_SENTRY_DSN=https://e82159f9c8f6da6e9a50e3bfed899854@o4511920193273856.ingest.de.sentry.io/4511920207626320

# Universal Links (iOS) / App Links (Android) — server-only, used by
# app/.well-known/apple-app-site-association and
# app/.well-known/assetlinks.json's route handlers to verify this domain is
# allowed to open the mobile app. See README's "Universal Links (iOS) /
# App Links (Android) Setup" section for where to find each value. Until
# both are set, links just always open in the browser — nothing breaks.
APPLE_TEAM_ID=your_apple_developer_team_id_here
ANDROID_SHA256_CERT_FINGERPRINT=your_release_signing_key_sha256_fingerprint_here
