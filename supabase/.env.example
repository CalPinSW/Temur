# Edge Function Secrets which need to be set in the Supabase Edge Function environment variables
#
# WARNING: `supabase secrets set KEY=VALUE` (even without --env-file) also
# silently re-pushes every OTHER key in this file to the remote project,
# alongside whatever you explicitly passed — confirmed by removing this
# file and observing that only the explicitly-passed key's timestamp
# changed on the remote project afterward. So: keep every value here equal
# to what you actually want live on the remote project too, or always pass
# --env-file explicitly and never bare `supabase secrets set KEY=VALUE`
# from this directory. This is why RESEND_FROM_EMAIL/PUBLIC_SITE_URL below
# use real (non-localhost/non-sandbox) values even though they're inert
# for local dev without a RESEND_API_KEY.
EDGE_FUNCTION_SECRET=edge_function_secret_here

# Email notifications (send-notification, sweep-visible-games) via Resend —
# https://resend.com. RESEND_API_KEY is required for email to send at all;
# without it, email is skipped silently and push still works independently
# (this is intentionally unset in the real local supabase/.env, so local
# dev never spends send quota). RESEND_FROM_EMAIL should be an address on
# a domain verified in the Resend dashboard (temur.app already is) — see
# the WARNING above for why this needs a real value even locally.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL="Temur <notifications@temur.app>"

# Used to build the "Open Temur" link in notification emails. See the
# WARNING above for why this needs a real value even locally.
PUBLIC_SITE_URL=https://www.temur.app

# Where bug reports (send-bug-report) get emailed. Independent of the
# client-facing NEXT_PUBLIC_SUPPORT_EMAIL/EXPO_PUBLIC_SUPPORT_EMAIL used for
# the "Contact Support" mailto link — edge functions can't read those.
SUPPORT_EMAIL=support@example.com

# NOT needed locally — send-auth-email (Supabase Auth's Send Email Hook,
# replaces Supabase's built-in auth email templates with Resend-branded
# ones) is only configured on the remote project, via the dashboard. See
# README.md's "Auth Emails (Resend)" section for the setup steps and why
# local dev intentionally isn't wired up to it.
# SEND_EMAIL_HOOK_SECRET="v1,whsec_your_generated_secret"

# Below this point: not edge function secrets — these are read directly by
# `supabase start` for config.toml's env() substitutions in
# [auth.external.google]/[auth.external.apple] (see comments there). Same
# file, different consumer: the Supabase CLI reads this file locally for
# both purposes, but only `supabase secrets set` pushes it to the remote
# Edge Function environment — these two never get deployed anywhere.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your_google_oauth_client_secret_here
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=your_apple_generated_client_secret_jwt_here
